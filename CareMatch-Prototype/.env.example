# Copy this file to ".env" (repo root) and fill in real values as needed.
# Never commit the actual ".env" file -- only this example should be shared.

# "real" (default, normal) actually calls your LLM provider (costs money,
# needs a real key below).
# "fake" is a EFREE DEVELOPER TESTING MOD -- placeholder answers, zero cost,
# zero network calls. It exists only so the automated test suite runs for
# free; it is never used in a real demo.
LLM_MODE=real

# Which AI service to use: "anthropic" or "openrouter".
LLM_PROVIDER=anthropic

# Only needed when LLM_MODE=real and LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Only needed when LLM_MODE=real and LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# LangSmith tracing/eval (senior-review step B). Tracing is skipped entirely
# in fake mode. Leave LANGSMITH_TRACING=false to disable without deleting keys.
# LANGSMITH_WORKSPACE_ID is required for org-scoped (lsv2_sk_) service keys --
# without it the API rejects requests with 403 Forbidden.
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=carematch-prototype
LANGSMITH_WORKSPACE_ID=your-workspace-id-here
