# Copy this file to ".env" (same folder, i.e. api/.env) and fill in real
# values as needed. Never commit the actual ".env" file.

# "real" (default, normal) actually calls your LLM provider (costs money,
# needs a real key below).
# "fake" is a FREE DEVELOPER TESTING MODE -- placeholder answers, zero cost,
# zero network calls -- for testing the API's plumbing (routing, validation,
# error handling) and the automated test suite. Never used in a real demo.
LLM_MODE=real

# Only needed when LLM_MODE=real. Same values as reasoning_engine/.env --
# copy them here too, since this is a separate process with its own
# environment.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=openai/gpt-oss-20b:free
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
