# Copy this file to ".env" (same folder) and fill in your real key.
# Never commit the actual ".env" file -- only this example file should
# be shared or checked into version control.

# Anthropic is the only provider. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional -- defaults to DEFAULT_ANTHROPIC_MODEL in llm_client.py if not set.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
