# Copy this file to ".env" (same folder, i.e. api/.env) and fill in real
# values as needed. Never commit the actual ".env" file.

# Every assessment makes a real call to your LLM provider (costs money,
# needs a real key below).
#
# Same values as reasoning_engine/.env -- copy them here too, since this is
# a separate process with its own environment.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=openai/gpt-oss-20b:free
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
