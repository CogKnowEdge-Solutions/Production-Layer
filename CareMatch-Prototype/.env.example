# Copy this file to ".env" (repo root) and fill in real values as needed.
# Never commit the actual ".env" file -- only this example should be shared.

# Postgres database. This is the "direct connection string" from Supabase
# (Project Settings -> Database). Never put the real value in this example
# file. If your password contains special characters like "@", percent-encode
# them (e.g. "@" -> %40) or the connection string will not parse.
DATABASE_URL=postgresql://postgres:your-password-here@db.your-project.supabase.co:5432/postgres

# Optional: schema to put all tables in. Leave unset for the default
# "public" schema. The test suite overrides this with a throwaway schema.
# CAREMATCH_DB_SCHEMA=public

# Every assessment makes a real call to Anthropic directly (costs money,
# needs a real key below). Anthropic is the only provider.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# LangSmith tracing/eval (senior-review step B). Leave LANGSMITH_TRACING=false
# to disable without deleting keys.
# LANGSMITH_WORKSPACE_ID is required for org-scoped (lsv2_sk_) service keys --
# without it the API rejects requests with 403 Forbidden.
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=carematch-prototype
LANGSMITH_WORKSPACE_ID=your-workspace-id-here
