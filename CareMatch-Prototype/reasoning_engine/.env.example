# Copy this file to ".env" (same folder) and fill in your real key.
# Never commit the actual ".env" file -- only this example file should
# be shared or checked into version control.

OPENROUTER_API_KEY=your-openrouter-key-here

# Optional -- defaults to anthropic/claude-3.5-sonnet if not set.
# See https://openrouter.ai/models for other options.
OPENROUTER_MODEL=openai/gpt-oss-20b:free
