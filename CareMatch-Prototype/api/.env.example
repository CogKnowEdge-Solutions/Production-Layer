# Copy this file to ".env" (same folder, i.e. api/.env) and fill in real
# values as needed. Never commit the actual ".env" file.

# ---------------------------------------------------------------------
# Database (Postgres / Supabase)
# ---------------------------------------------------------------------
# ONE variable is read: DATABASE_URL. The separate PG* variables are NOT
# used -- don't set them expecting them to take effect.
#
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Replace [YOUR-PASSWORD] with your database password.
#
# Use the CONNECTION POOLER host (port 6543) for serverless/Cloud Run,
# where many short-lived instances would otherwise exhaust direct
# connections. Use the direct host (port 5432) for long-running servers.
#
#   Pooler:  postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#   Direct:  postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
#
# sslmode=require is strongly recommended -- Supabase accepts TLS on both
# hosts and without it psycopg2 may negotiate an unencrypted connection.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carematch

# Max pooled connections per API process (default 10). Keep this low when
# running many instances against the Supabase pooler.
DB_POOL_MAX=10

# Used ONLY by api/test_api.py. The test suite creates and DROPS tables,
# so this must point at a throwaway database -- never at the DATABASE_URL
# above, and never at a Supabase project holding real data.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/carematch_test

# ---------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------
# Every assessment makes a real call to Anthropic directly (costs money,
# needs a real key below).
#
# Same values as reasoning_engine/.env -- copy them here too, since this is
# a separate process with its own environment.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
