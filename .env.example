# CareMatch API environment configuration
# Copy to .env and adjust values. NEVER commit real secrets.

# --- Runtime ---
ENV=development
LOG_LEVEL=info

# --- Database ---
# Default: local SQLite file. For production use PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg://carematch:password@localhost:5432/carematch
DATABASE_URL=sqlite:///./carematch.db

# --- Redis cache (optional; falls back to in-memory if unreachable) ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_DEFAULT=3600

# --- Auth / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Seed users (dev only; used on startup when no users exist) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin-password-change-me
SEED_COORDINATOR_USERNAME=coordinator
SEED_COORDINATOR_PASSWORD=coordinator-password-change-me
SEED_PROVIDER_USERNAME=provider
SEED_PROVIDER_PASSWORD=provider-password-change-me
SEED_AUDITOR_USERNAME=auditor
SEED_AUDITOR_PASSWORD=auditor-password-change-me

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=100
